<Application x:Class="CCI_QuickTools2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CCI_QuickTools2"
             xmlns:conv="clr-namespace:CCI_QuickTools2.Converters"
             xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FluentWPF;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="Resources/Brushes.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/Animations.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters Global Registry -->
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <conv:EqualityConverter x:Key="EqualityConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
            <conv:CaseConverter x:Key="CaseConverter" />
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <conv:TypeToBooleanConverter x:Key="TypeToBooleanConverter" />
            <conv:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
            <conv:BooleanToColorConverter x:Key="BooleanToColorConverter" />
            <conv:BooleanToStringConverter x:Key="BooleanToStringConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <conv:PercentageToWidthConverter x:Key="PercentageToWidthConverter" />

            <!-- Default Styles Targeting Types -->
            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" />
            <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBoxStyle}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}" />
            <Style TargetType="ProgressBar" BasedOn="{StaticResource ModernProgressStyle}" />
            <Style TargetType="RadioButton" BasedOn="{StaticResource NavButtonStyle}" />
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
